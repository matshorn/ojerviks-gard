---
import Layout from "../layouts/Layout.astro";
---

<Layout title="Celebrate" description="Meet & Celebrate at a 2,500 acre estate with 14 rooms.">
	<div class="page-header">
		<h1>Meet &amp; Celebrate</h1>
		<p>
			A 2,500 acre estate with 14 rooms, each with their own bathroom, distributed across
			multiple two to seven bedroom houses and cottages. Get in touch for group rates.
		</p>
	</div>

	<section>
		<h2>Meetings &amp; incentives</h2>
		<div class="cards">
			<div class="card">
				<img src="/images/047_Office.webp" alt="Office and meeting space" />
				<h3>Planning &amp; brainstorming</h3>
				<p>Businesses use the farm for planning and brainstorming sessions away from the office.</p>
			</div>
			<div class="card">
				<img src="/images/034_DJI_0187.webp" alt="The estate from above" />
				<h3>Rewards &amp; incentives</h3>
				<p>A reward for outstanding performance, with expert staff coordinating team building and motivation.</p>
			</div>
		</div>
	</section>

	<section>
		<h2>Family celebrations</h2>
		<p class="lede">
			From anniversaries to birthday celebrations and family reunions — the Farmhouse is
			kid-friendly, so the whole family is welcome.
		</p>
	</section>

	<section>
		<h2>Weddings</h2>
		<div class="hero" style="margin-top: 1rem;">
			<img src="/images/017_518d55fe-82c7-498f-9d8b-a20a7000d119_5ba79dfe9606ee670968a87b.webp" alt="Wedding dinner in the Hall of Mirrors at Rottneros Park" />
			<div class="hero-caption">
				<p>In partnership with Rottneros Park — a 1st class dinner in the Hall of Mirrors.</p>
			</div>
		</div>
		<p class="lede">Every detail can be customized for an exclusive celebration.</p>
	</section>

	<section>
		<a class="cta" href="mailto:hej@ojerviksgard.se">Enquire about group rates</a>
	</section>
</Layout>
