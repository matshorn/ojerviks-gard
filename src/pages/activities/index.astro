---
import Layout from "../../layouts/Layout.astro";
---

<Layout title="Activities" description="Everything worth doing on the farm and around Sunne.">
	<div class="page-header">
		<h1>You simply can't get bored</h1>
		<p>Between the farm and nearby Sunne, there's always something to do — organized like a
		little field guide, written by someone who actually lives here.</p>
	</div>

	<section class="cards">
		<a class="card" href="/activities/outdoors-water">
			<img src="/images/029_DJI_0178.webp" alt="Lake Fryken from above" />
			<h3>Outdoors &amp; Water</h3>
			<p>Hiking, beaches, canoeing, fishing, and winter sports.</p>
		</a>
		<a class="card" href="/activities/sport-leisure">
			<img src="/images/046_jacuzzi.webp" alt="Spa and leisure" />
			<h3>Sport &amp; Leisure</h3>
			<p>Tennis, padel, golf, biking, bowling, and spas.</p>
		</a>
		<a class="card" href="/activities/culture-sights">
			<img src="/images/024_from_the_lake.webp" alt="The Fryksdalen valley" />
			<h3>Culture &amp; Sights</h3>
			<p>Museums, parks, theater, and local artists.</p>
		</a>
		<a class="card" href="/activities/food-drink">
			<img src="/images/031_dining_area.webp" alt="Dining" />
			<h3>Food &amp; Drink</h3>
			<p>Restaurants, bars, breweries, and groceries.</p>
		</a>
	</section>
</Layout>
