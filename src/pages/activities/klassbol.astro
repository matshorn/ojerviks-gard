import Layout from "../../layouts/Layout.astro";
---

<Layout title="Klässbol" description="Home to the weavers of the Nobel Banquet's table linens, ~35 minutes from the farm.">
	<p class="breadcrumb"><a href="/activities">Activities</a> › <a href="/activities/culture-sights">Culture &amp; Sights</a> › Klässbol</p>

	<div class="factcard">
		<div class="factcard-title">Klässbols Linneväveri</div>
		<table>
			<tr><th>Type</th><td>Linen weavery &amp; shop</td></tr>
			<tr><th>Location</th><td>Klässbol, Arvika municipality</td></tr>
			<tr><th>Distance</th><td>~35 min drive</td></tr>
			<tr><th>Known for</th><td>Weaving the Nobel Banquet's table linens since 1991</td></tr>
		</table>
	</div>

	<div class="page-header">
		<h1>Klässbol</h1>
	</div>

	<div class="prose">
		<p>
			Klässbols Linneväveri is a fourth-generation, family-run linen weavery that's been at it
			since 1920, when founder Hjalmar Johansson began weaving linen sheets and cloths from
			local flax. Since 1991, it's woven the tablecloths and napkins used at the Nobel Banquet
			every single year, and it produced the wedding linens gifted to Crown Princess Victoria
			and Prince Daniel.
		</p>
		<p>
			Worth the drive for the shop alone if beautiful table linen is your thing — it's usually
			combined with a stop at the <a href="/activities/rackstad-museum">Rackstad museum</a> in
			nearby Arvika.
		</p>
	</div>
</Layout>
